{
  "model": "resnet18",
  "pretrained": true,
  "optimizer": "sgd",
  "lr": 0.01,
  "momentum": 0.9,
  "nesterov": true,
  "weight_decay": 0.0001,
  "batch_size": 32,
  "epochs": 8,
  "lr_decay_epochs": [],
  "lr_decay_factor": 0.1,
  "loss": "cross_entropy",
  "max_species": 80,
  "max_images_per_species": 80,
  "prioritize_toxicity_species": true
}
