__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Large / downloaded artifacts (see README: "Data & models")
data/raw/*
!data/raw/plantnet/
data/raw/plantnet/*
# ...except the species table, which maps a class index to a name. It
# is 104KB of taxonomy and the model is unusable without it.
!data/raw/plantnet/species_metadata.csv
models/*
!models/.gitkeep

# Training runs (scripts/remote/pull.sh fetches these back from the
# remote PC): checkpoints are large binaries, outputs' small JSON is
# left untracked for now too - a Phase 4 decision, not an automatic one.
outputs/
checkpoints/

# Local scratch
*.log
.env

# Machine-specific remote-training config (SSH host, remote username);
# see scripts/remote/config.sh.example
scripts/remote/config.sh

# Personal photos used for local testing
data/images/
photos/

# Jupyter
.ipynb_checkpoints/

# Model weights that libraries sometimes drop in the working directory
*.pt

# Agent instructions - kept local only, not published
CLAUDE.md

# Working notebooks from earlier phases, kept on disk but out of the
# repo: the published set is notebooks/0[0-3]_*.
notebooks/00_project_overview.ipynb
notebooks/01_plantnet_class_distribution.ipynb
notebooks/02_plantnet_baseline_results.ipynb
